{
  "name": "@deepseek-ai/dsh-persona-sync",
  "description": "Persona sync client: pushes shared streams to the edge, pulls by cursor, never uploads DMs or private streams",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miguelltasso-dom/persona.git",
    "directory": "packages/persona/persona-sync"
  },
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-persona-core": "workspace:*"
  }
}
