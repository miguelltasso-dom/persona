{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./.oxlintrc.json"],
  "options": {
    "typeAware": false
  },
  "ignorePatterns": [
    "**/lib/**",
    "**/node_modules/**",
    "**/.sessions/**",
    ".claude/**",
    "**/.doc-typecheck-*/**",
    "**/.node-next-types-*/**",
    "website/.generated/**",
    "vendor/**",
    "packages/persona/persona-engine/src/core/**", // MIT port of dsh-superagent-prototype src/core: keeps upstream style for provenance (D-042).
    "packages/persona/persona-engine/tests/core-engine.spec.ts", // ported test suite, same reason.
    "packages/persona/persona-engine/tests/stage.spec.ts",
    "native/**",
    "**/*.js",
    "**/*.mjs",
    "**/*.config.ts",
    "packages/client/tsdown.client.ts"
  ]
}
