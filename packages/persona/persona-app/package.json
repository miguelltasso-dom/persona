{
  "name": "@deepseek-ai/dsh-persona-app",
  "description": "Persona product bundle layered over dsh-base and dsh-web-app",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miguelltasso-dom/persona.git",
    "directory": "packages/persona/persona-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-persona-host": "workspace:*",
    "@deepseek-ai/dsh-persona-runners": "workspace:*",
    "@deepseek-ai/dsh-persona-usage": "workspace:*",
    "@deepseek-ai/dsh-persona-vault": "workspace:*",
    "@deepseek-ai/dsh-client-ui-persona": "workspace:*"
  }
}
