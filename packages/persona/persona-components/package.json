{
  "name": "@deepseek-ai/dsh-persona-components",
  "description": "On-demand runtime components (LibreOffice, Python, MinGit, pnpm) with pinned hashes",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
